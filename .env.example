# MAX Messenger Bot
MAX_BOT_TOKEN=your_bot_token_from_masterbot

# Закрытый канал MAX (числовой ID)
MAX_CHANNEL_ID=123456789

# ЮKassa
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# Параметры подписки
SUBSCRIPTION_PRICE=99.00
SUBSCRIPTION_CURRENCY=RUB
SUBSCRIPTION_MONTHS=1

# PostgreSQL (Railway подставляет автоматически)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Интервал проверки платежей и истечений (секунды)
POLL_INTERVAL_SECONDS=15

# Только для тестов — удалить в продакшне
# SUBSCRIPTION_MINUTES=2
