# MAX Messenger Bot
MAX_BOT_TOKEN=your_bot_token_from_masterbot

# Закрытый канал MAX (числовой ID)
MAX_CHANNEL_ID=123456789

# Ссылка-приглашение в канал (получить в настройках канала)
MAX_CHANNEL_INVITE_LINK=https://max.ru/join/xxxx

# ЮKassa (тестовый магазин)
YOOKASSA_SHOP_ID=100500
YOOKASSA_SECRET_KEY=test_your_secret_key_here

# Параметры подписки
SUBSCRIPTION_PRICE=99.00
SUBSCRIPTION_CURRENCY=RUB

# Для теста истечения: задай SUBSCRIPTION_MINUTES=2, иначе используется SUBSCRIPTION_MONTHS
# SUBSCRIPTION_MINUTES=2
SUBSCRIPTION_MONTHS=1

# Путь к БД
DB_PATH=subscriptions.db

# Интервал проверки платежей и истечений (секунды)
POLL_INTERVAL_SECONDS=15
